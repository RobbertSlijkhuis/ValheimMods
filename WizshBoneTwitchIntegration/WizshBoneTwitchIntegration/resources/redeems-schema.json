{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Configuration schema for Valheim Twitch Integration redeems",
  "properties": {
    "redeems": {
      "description": "Array of Twitch channel point redeems",
      "items": {
        "properties": {
          "backgroundColor": {
            "description": "Hex color code for the redeem background",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "chest": {
            "description": "Configuration for SurpriseChest type redeems",
            "properties": {
              "amount": {
                "description": "Number of items to spawn in the chest",
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              "announceMessage": {
                "description": "Message to announce when the chest spawns",
                "type": "string"
              },
              "force": {
                "description": "Force applied when spawning items from the chest",
                "minimum": 0,
                "type": "number"
              },
              "interact": {
                "description": "Whether the chest can be interacted with",
                "type": "boolean"
              },
              "items": {
                "description": "Pool of possible items/creatures to spawn from",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "random": {
                "description": "Whether to randomly select items from the pool",
                "type": "boolean"
              },
              "type": {
                "description": "Type of chest to spawn",
                "enum": [ "Iron", "Gold" ],
                "type": "string"
              },
              "yeetChance": {
                "description": "Percentage chance that items will be yeeted/thrown",
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "cooldown": {
            "description": "Cooldown time in seconds before the redeem can be used again",
            "minimum": 0,
            "type": "integer"
          },
          "creatures": {
            "description": "Array of creatures to spawn (for SpawnCreature type)",
            "items": {
              "properties": {
                "aggravatable": {
                  "description": "Whether the creature can be aggravated",
                  "type": "boolean"
                },
                "allowDamageStructures": {
                  "description": "Whether the creature can damage structures",
                  "type": "boolean"
                },
                "allowDrops": {
                  "description": "Whether the creature drops items on death",
                  "type": "boolean"
                },
                "amount": {
                  "description": "Number of creatures to spawn",
                  "minimum": 1,
                  "type": "integer"
                },
                "commandable": {
                  "description": "Whether the creature can be commanded by the player (requires friendly=true)",
                  "type": "boolean"
                },
                "friendly": {
                  "description": "Whether the creature is friendly to the player",
                  "type": "boolean"
                },
                "level": {
                  "description": "Creature level/stars (1=no star, 2=1 star, 3=2 stars)",
                  "maximum": 10,
                  "minimum": 1,
                  "type": "integer"
                },
                "maxHealth": {
                  "description": "Maximum health for the spawned creature",
                  "minimum": 1,
                  "type": "number"
                },
                "mistVision": {
                  "description": "Whether the creature can see through mist",
                  "type": "boolean"
                },
                "position": {
                  "description": "Where to spawn the creature relative to the player",
                  "enum": [
                    "Flying",
                    "InFrontOfPlayer",
                    "OnPlayer",
                    "RandomBehind",
                    "Undefined",
                    "WorldPosition"
                  ],
                  "type": "string"
                },
                "positionOffset": {
                  "description": "Offset from the spawn position in local or world coordinates",
                  "properties": {
                    "x": {
                      "description": "X-axis offset",
                      "type": "number"
                    },
                    "y": {
                      "description": "Y-axis offset (height)",
                      "type": "number"
                    },
                    "z": {
                      "description": "Z-axis offset",
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "prefabName": {
                  "description": "The prefab name of the creature to spawn",
                  "type": "string"
                },
                "rename": {
                  "description": "Whether to rename the spawned creature to the redeemer's Twitch name",
                  "type": "boolean"
                },
                "talkInteract": {
                  "description": "Whether the creature can be interacted with for dialogue",
                  "type": "boolean"
                },
                "talkInterval": {
                  "description": "Interval in seconds between creature talk messages",
                  "minimum": 0,
                  "type": "number"
                },
                "talkMessage": {
                  "description": "The message(s) the creature will say when interacted with (use semicolons to separate multiple messages)",
                  "type": "string"
                },
                "talks": {
                  "description": "Whether the creature can talk",
                  "type": "boolean"
                }
              },
              "required": [ "prefabName" ],
              "type": "object"
            },
            "type": "array"
          },
          "globalKeyAdd": {
            "description": "Global key that must be active for this redeem to be available",
            "examples": [
              "defeated_eikthyr",
              "defeated_gdking",
              "defeated_bonemass",
              "defeated_dragon",
              "defeated_goblinking",
              "defeated_queen",
              "defeated_fader",
              "killedtroll",
              "killedBat",
              "killed_surtling"
            ],
            "type": "string"
          },
          "globalKeyRemove": {
            "description": "Global key that, when active, will disable this redeem",
            "examples": [
              "defeated_eikthyr",
              "defeated_gdking",
              "defeated_bonemass",
              "defeated_dragon",
              "defeated_goblinking",
              "defeated_queen",
              "defeated_fader",
              "killedtroll",
              "killedBat",
              "killed_surtling"
            ],
            "type": "string"
          },
          "ignoreWard": {
            "description": "Whether this redeem should ignore ward protection",
            "type": "boolean"
          },
          "mist": {
            "description": "Configuration for SpawnMist type redeems",
            "properties": {
              "announceMessage": {
                "description": "Message to announce when the mist spawns",
                "type": "string"
              },
              "duration": {
                "description": "Duration of the mist effect in seconds",
                "minimum": 0,
                "type": "number"
              },
              "height": {
                "description": "Height of the mist effect",
                "minimum": 0,
                "type": "number"
              },
              "radius": {
                "description": "Radius of the mist effect",
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "points": {
            "description": "The cost in channel points",
            "minimum": 1,
            "type": "integer"
          },
          "shower": {
            "description": "Configuration for SpawnShower type redeems",
            "oneOf": [
              {
                "required": [ "prefabName" ]
              },
              {
                "required": [ "spawns" ]
              }
            ],
            "properties": {
              "accuracy": {
                "description": "Accuracy of the spawned projectiles",
                "type": "number"
              },
              "announceMessage": {
                "description": "Message to announce when the shower starts",
                "type": "string"
              },
              "damage": {
                "description": "Damage properties for spawned projectiles",
                "properties": {
                  "blunt": {
                    "description": "Blunt damage amount",
                    "type": "number"
                  },
                  "chop": {
                    "description": "Chopping damage amount",
                    "type": "number"
                  },
                  "damage": {
                    "description": "Physical damage amount",
                    "type": "number"
                  },
                  "fire": {
                    "description": "Fire damage amount",
                    "type": "number"
                  },
                  "frost": {
                    "description": "Frost damage amount",
                    "type": "number"
                  },
                  "lightning": {
                    "description": "Lightning damage amount",
                    "type": "number"
                  },
                  "pickaxe": {
                    "description": "Pickaxe damage amount",
                    "type": "number"
                  },
                  "pierce": {
                    "description": "Pierce damage amount",
                    "type": "number"
                  },
                  "poison": {
                    "description": "Poison damage amount",
                    "type": "number"
                  },
                  "spirit": {
                    "description": "Spirit damage amount",
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "dropVelocity": {
                "description": "Velocity at which objects drop",
                "type": "number"
              },
              "groundOffset": {
                "description": "Height offset from ground for spawning",
                "type": "number"
              },
              "initialSpawnDelay": {
                "description": "Initial delay before spawning begins (in seconds)",
                "type": "number"
              },
              "isBiomeList": {
                "description": "Whether spawns list contains biome-specific prefabs",
                "type": "boolean"
              },
              "maxSpawned": {
                "description": "Maximum number of entities can be active at once from this redeem",
                "minimum": 1,
                "type": "integer"
              },
              "maxTargetRange": {
                "description": "Maximum range for targeting",
                "minimum": 0,
                "type": "number"
              },
              "maxToSpawn": {
                "description": "Maximum number to spawn",
                "minimum": 1,
                "type": "integer"
              },
              "minToSpawn": {
                "description": "Minimum number to spawn",
                "minimum": 1,
                "type": "integer"
              },
              "prefabName": {
                "description": "The prefab name to spawn as a shower effect",
                "type": "string"
              },
              "randomAngleMax": {
                "description": "Maximum random angle for spawning",
                "type": "number"
              },
              "randomAngleMin": {
                "description": "Minimum random angle for spawning",
                "type": "number"
              },
              "randomDirection": {
                "description": "Whether to randomize spawn direction",
                "type": "boolean"
              },
              "randomYRotation": {
                "description": "Whether to randomize Y rotation",
                "type": "boolean"
              },
              "spawnDelay": {
                "description": "Delay between each spawn in seconds",
                "minimum": 0,
                "type": "number"
              },
              "spawnRadius": {
                "description": "Radius within which to spawn objects",
                "type": "number"
              },
              "spawns": {
                "description": "Array of prefab names to spawn",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "targetType": {
                "description": "Type of targeting for the shower effect",
                "enum": [ "ClosestEnemy", "RandomEnemy", "Caster", "Position", "RandomPathfindablePosition" ],
                "type": "string"
              },
              "velocity": {
                "description": "Base velocity for spawned projectiles",
                "type": "number"
              },
              "velocityMax": {
                "description": "Maximum velocity for spawned projectiles",
                "type": "number"
              }
            },
            "type": "object"
          },
          "statusEffects": {
            "description": "Array of status effect names to apply (for StatusEffect type)",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "description": "The title displayed for the redeem on Twitch",
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "description": "The type of redeem action",
            "enum": [
              "ExplodeFish",
              "PlayerGrow",
              "PlayerShrink",
              "SpawnCreature",
              "SpawnHallucination",
              "SpawnShower",
              "SpawnMist",
              "SurpriseChest",
              "StatusEffect",
              "StatusEffectRandom",
              "TerrainRemove",
              "Undefined"
            ],
            "type": "string"
          },
          "userInput": {
            "description": "Whether to prompt the user for input when redeeming",
            "type": "boolean"
          }
        },
        "required": [ "type", "title", "points" ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": { "const": "SpawnCreature" }
              }
            },
            "then": {
              "required": [ "creatures" ]
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "SpawnShower" }
              }
            },
            "then": {
              "required": [ "shower" ]
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "SpawnMist" }
              }
            },
            "then": {
              "required": [ "mist" ]
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "SurpriseChest" }
              }
            },
            "then": {
              "required": [ "chest" ]
            }
          },
          {
            "if": {
              "properties": {
                "type": { "const": "StatusEffect" }
              }
            },
            "then": {
              "required": [ "statusEffects" ]
            }
          }
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [ "redeems" ],
  "title": "WizshBone Twitch Integration Redeems Configuration",
  "type": "object"
}
